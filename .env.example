# Copy to .env.local and restart `npm run dev`. On Vercel, add these as (Sensitive) env vars.

# Option A — Vertex AI with a service account (used when these are set)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GCP_CLIENT_EMAIL=
# The JSON key's private_key, on one line with literal \n, in double quotes
GCP_PRIVATE_KEY=""

# Option B — a Gemini API key instead (leave the Vertex vars out)
# GEMINI_API_KEY=

# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
